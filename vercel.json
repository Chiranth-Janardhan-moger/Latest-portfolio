{
  "version": 2,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "src": "/admin",
      "dest": "/api/index.ts"
    },
    {
      "src": "/\\.env",
      "dest": "/api/index.ts"
    },
    {
      "src": "/wp-admin",
      "dest": "/api/index.ts"
    },
    {
      "src": "/wp-login\\.php",
      "dest": "/api/index.ts"
    },
    {
      "src": "/\\.git",
      "dest": "/api/index.ts"
    },
    {
      "src": "/config",
      "dest": "/api/index.ts"
    },
    {
      "src": "/config\\.json",
      "dest": "/api/index.ts"
    },
    {
      "src": "/administrator",
      "dest": "/api/index.ts"
    },
    {
      "src": "/\\.env\\.local",
      "dest": "/api/index.ts"
    },
    {
      "src": "/\\.env\\.production",
      "dest": "/api/index.ts"
    },
    {
      "src": "/etc/passwd",
      "dest": "/api/index.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
